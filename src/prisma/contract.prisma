// use prisma-8

model User {
  id           Int      @id @default(autoincrement())
  firstName    String
  lastName     String
  email        String   @unique
  passwordHash String
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  events       Event[]
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  eventDate   String
  eventTime   String?
  location    String?
  description String?
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  userId      Int
  user        User     @relation(fields: [userId], references: [id])

  guests      Guest[]
}

model Guest {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  email     String?
  token     String   @unique
  status    String   @default("pending")
  maxCompanions Int @default(0)
  companionCount Int @default(0)
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  eventId   Int
  event     Event    @relation(fields: [eventId], references: [id])
}