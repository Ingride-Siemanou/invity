// use prisma-8

model User {
  id           Int      @id @default(autoincrement())
  firstName    String
  lastName     String
  email        String   @unique
  passwordHash String
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  events       Event[]
}

model Event {
  id              Int      @id @default(autoincrement())
  title           String
  eventDate       String
  eventTime       String?
  location        String?
  description     String?

  childrenPolicy  String   @default("allowed")
  minimumChildAge Int?
  dressCode       String?
  importantInfo   String?

  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()

  userId          Int
  user            User     @relation(fields: [userId], references: [id])

  guests          Guest[]
  questions       Question[]
}

model Guest {
  id              Int      @id @default(autoincrement())
  firstName       String
  lastName        String
  email           String?
  token           String   @unique
  status          String   @default("pending")

  maxCompanions   Int      @default(0)
  companionCount  Int      @default(0)

  childrenCount   Int      @default(0)
  childrenAges    String?

  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()

  eventId         Int
  event           Event    @relation(fields: [eventId], references: [id])

  answers         Answer[]
}

model Question {
  id                  Int      @id @default(autoincrement())
  label               String
  type                String   @default("text")
  required            Boolean  @default(false)
  position            Int      @default(0)

  conditionQuestionId Int?
  conditionValue      String?

  createdAt           TimestamptzString @default(now())
  updatedAt           temporal.updatedAtString()

  eventId             Int
  event               Event    @relation(fields: [eventId], references: [id])

  answers             Answer[]
}

model Answer {
  id          Int      @id @default(autoincrement())
  value       String

  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  guestId     Int
  guest       Guest    @relation(fields: [guestId], references: [id])

  questionId  Int
  question    Question @relation(fields: [questionId], references: [id])

  @@unique([guestId, questionId])
}